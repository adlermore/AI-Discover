  play: '<path d="M8 5.5v13l10.5-6.5z"/>',
};
const { name, size, class: cls, ...rest } = Astro.props;
---
<svg
  class:list={[cls, `i-${name}`]}
  width={size ?? 24} height={size ?? 24} viewBox="0 0 24 24" fill="none" stroke="currentColor"
  stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" {...rest}
  set:html={PATHS[name]}
/>
