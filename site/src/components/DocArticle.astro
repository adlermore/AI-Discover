---
// A long document page: header, sticky table of contents, extracted HTML.
import Icon from './Icon.astro';
const { kicker, title, sub, meta = [], toc = [], html, lang = 'hy', pdf, tocTitle = 'Բովանդակություն' } = Astro.props;
---
<div class="container">
  <header class="page-head doc-head">
    <span class="kicker">{kicker}</span>
    <h1 lang={lang}>{title}</h1>
    {sub && <p class="lead" lang={lang}>{sub}</p>}
    <div class="doc-head-row">
      {meta.length > 0 && (
        <dl class="doc-meta" lang={lang}>
          {meta.map((m) => (<div><dt>{m.k}</dt><dd>{m.v}</dd></div>))}
        </dl>
      )}
      <div class="doc-actions">
        <slot name="actions" />
        {pdf && (
          <a class="btn btn-ghost btn-sm" href={pdf.href}><Icon name="file" />PDF · {pdf.pages} էջ</a>
        )}
      </div>
    </div>
  </header>

  <div class="with-toc left doc-body">
    <nav class="toc" aria-label={tocTitle}>
      <h4>{tocTitle}</h4>
      <ol lang={lang}>
        {toc.map((t) => (
          <li><a href={`#${t.id}`} class:list={[t.sub && 'sub']}>{t.kicker && <span class="k">{t.kicker.replace(/^\d+\s*·\s*/, '')}</span>}{t.title}</a></li>
        ))}
      </ol>
    </nav>
    <article class="doc" lang={lang}>
      <slot name="before" />
      <Fragment set:html={html} />
      <slot />
    </article>
  </div>
</div>

<style>
  .doc-head { padding-bottom: 32px; margin-bottom: 40px; border-bottom: 1px solid var(--line); }
  .doc-head-row { display: flex; flex-wrap: wrap; align-items: flex-end; justify-content: space-between; gap: 20px; margin-top: 18px; }
  .doc-meta { display: flex; flex-wrap: wrap; gap: 10px 28px; margin: 0; }
  .doc-meta dt { font-size: 11px; letter-spacing: 0.12em; text-transform: uppercase; color: var(--muted); }
  .doc-meta dd { margin: 2px 0 0; font-weight: 600; color: var(--ink); font-size: 14.5px; }
  .doc-actions { display: flex; flex-wrap: wrap; gap: 8px; }
  .doc-body article { max-width: 820px; min-width: 0; }
  .toc a.sub { padding-left: 28px; font-size: 13.5px; }
</style>
