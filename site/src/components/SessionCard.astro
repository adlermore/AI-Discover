---
import Icon from './Icon.astro';
const { s } = Astro.props;
const tools = s.allTools ? ['ամբողջ փաթեթը'] : s.tools;
const haystack = [s.n, s.title, s.result, s.goal, s.toolsRaw, ...s.prompts.map((p) => p.title)].join(' ').toLowerCase();
---
<a
  class="scard"
  href={s.href}
  data-phase={s.phase}
  data-session={s.n}
  data-next-session={s.n}
  data-filter-phase={s.phase}
  data-filter-tools={`|${s.tools.join('|')}|`}
  data-filter-text={haystack}
>
  <div class="scard-top">
    <span class="num-circle">{s.n}</span>
    <span class="scard-meta">Փուլ {s.phase} · շաբաթ {s.week}</span>
    <span class="scard-state" title="Ավարտված է"><Icon name="check" /></span>
  </div>
  <h3>{s.title}</h3>
  {s.result && <p class="scard-res"><b>Արդյունք՝</b> {s.result}</p>}
  <div class="scard-foot">
    <div class="chips">
      {tools.slice(0, 3).map((t) => <span class="chip">{t}</span>)}
      {tools.length > 3 && <span class="chip">+{tools.length - 3}</span>}
    </div>
    {s.prompts.length > 0 && <span class="scard-pr tnum">{s.prompts.length} պրոմպտ</span>}
  </div>
</a>

<style>
  .scard {
    position: relative; display: flex; flex-direction: column; gap: 10px; padding: 18px 18px 16px;
    background: var(--surface); border: 1px solid var(--line); border-radius: var(--radius);
    text-decoration: none; color: inherit; box-shadow: var(--shadow-sm); overflow: hidden;
    transition: transform 0.18s, box-shadow 0.18s, border-color 0.18s;
  }
  .scard::before { content: ''; position: absolute; inset: 0 0 auto; height: 3px; background: var(--ph); opacity: 0.9; }
  .scard:hover { transform: translateY(-3px); box-shadow: var(--shadow); border-color: color-mix(in srgb, var(--ph) 40%, var(--line)); }
  .scard-top { display: flex; align-items: center; gap: 10px; }
  .scard-meta { font-size: 12.5px; color: var(--muted); font-weight: 560; }
  .scard-state {
    margin-left: auto; width: 26px; height: 26px; border-radius: 50%; display: grid; place-items: center;
    border: 1.5px dashed var(--line-strong); color: transparent;
  }
  .scard-state svg { width: 15px; height: 15px; }
  .scard.is-done .scard-state { border: 0; background: var(--good); color: #fff; }
  .scard.is-next { border-color: color-mix(in srgb, var(--ph) 55%, var(--line)); box-shadow: 0 0 0 3px var(--ph-soft), var(--shadow-sm); }
  h3 { font-size: 17px; line-height: 1.35; font-weight: 650; }
  .scard-res { margin: 0; font-size: 14px; color: var(--text-2); line-height: 1.5; }
  .scard-res b { color: var(--ink); font-weight: 600; }
  .scard-foot { margin-top: auto; padding-top: 6px; display: flex; align-items: center; justify-content: space-between; gap: 10px; }
  .scard-pr { font-size: 12.5px; color: var(--prompt-ink); font-weight: 650; white-space: nowrap; }
  .chip { height: 24px; font-size: 12px; }
</style>
