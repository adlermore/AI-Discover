---
// A 90-minute lesson as a proportional segmented bar plus a readable legend.
// segments: [{ from, to, label?, text }]
const { segments, phase, legend = true, compact = false } = Astro.props;
const total = segments.at(-1).to - segments[0].from;
const ticks = [0, 15, 30, 45, 60, 75, 90].filter((t) => t <= total);
---
<div class:list={['flow', compact && 'compact']} data-phase={phase}>
  <div class="flow-bar" role="img" aria-label={`${total} րոպեի բաշխումը`}>
    {segments.map((s, i) => (
      <div
        class="flow-seg"
        data-alt={i % 2 ? 'true' : 'false'}
        style={`flex:${s.to - s.from} 1 0`}
        tabindex="0"
        data-tip-meta={`${s.from}–${s.to} րոպե`}
        data-tip-title={s.label}
        data-tip={s.text}
      >
        <span class="flow-lbl">{s.label ?? `${s.from}–${s.to}`}</span>
        <span class="flow-min">{s.to - s.from} ր</span>
      </div>
    ))}
  </div>
  <div class="flow-axis" aria-hidden="true">
    {ticks.map((t) => <span style={`left:${(t / total) * 100}%`}>{t}</span>)}
  </div>
  {legend && (
    <ol class="flow-legend">
      {segments.map((s, i) => (
        <li data-alt={i % 2 ? 'true' : 'false'}>
          <span class="when tnum">{s.from}–{s.to}</span>
          <span class="what">{s.label && <b>{s.label}</b>}{s.text}</span>
        </li>
      ))}
    </ol>
  )}
</div>

<style>
  .flow { --c: var(--ph, var(--accent)); --c-soft: var(--ph-soft, var(--accent-soft)); }
  .flow-bar { display: flex; gap: 2px; height: 56px; border-radius: 12px; overflow: hidden; }
  .compact .flow-bar { height: 40px; border-radius: 10px; }
  .flow-seg {
    min-width: 0; display: flex; flex-direction: column; justify-content: center; padding: 0 12px;
    background: var(--c); color: #fff; cursor: default; transition: filter 0.15s;
  }
  .flow-seg[data-alt='true'] { background: var(--c-soft); color: var(--ink); }
  .flow-seg:hover, .flow-seg:focus-visible { filter: brightness(1.08) saturate(1.1); outline: none; }
  .flow-lbl, .flow-min { white-space: nowrap; overflow: hidden; text-overflow: ellipsis; line-height: 1.25; }
  .flow-lbl { font-size: 13.5px; font-weight: 650; }
  .flow-min { font-size: 11.5px; opacity: 0.8; font-variant-numeric: tabular-nums; }
  .compact .flow-lbl { font-size: 12.5px; }
  .compact .flow-min { display: none; }
  .flow-axis { position: relative; height: 22px; margin: 4px 0 0; font-size: 11.5px; color: var(--muted); font-variant-numeric: tabular-nums; }
  .flow-axis span { position: absolute; top: 2px; transform: translateX(-50%); }
  .flow-axis span:first-child { transform: none; }
  .flow-axis span:last-child { transform: translateX(-100%); }
  .flow-legend { list-style: none; margin: 14px 0 0; padding: 0; display: grid; gap: 2px; }
  .flow-legend li { display: grid; grid-template-columns: 64px minmax(0, 1fr); gap: 14px; padding: 10px 0; border-top: 1px solid var(--line); font-size: 15px; }
  .flow-legend li:first-child { border-top: 0; }
  .flow-legend .when { font-weight: 700; color: var(--ink); position: relative; padding-left: 16px; }
  .flow-legend .when::before { content: ''; position: absolute; left: 0; top: 7px; width: 9px; height: 9px; border-radius: 3px; background: var(--c); }
  .flow-legend li[data-alt='true'] .when::before { background: var(--c-soft); box-shadow: inset 0 0 0 1.5px var(--c); }
  .flow-legend b { color: var(--ink); margin-right: 6px; }
  @media (max-width: 640px) {
    .flow-seg { padding: 0 7px; }
    .flow-lbl { font-size: 11.5px; }
    .flow-min { display: none; }
  }
</style>
