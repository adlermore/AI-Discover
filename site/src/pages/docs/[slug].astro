---
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import { docs, url } from '../../lib/data.js';

export function getStaticPaths() {
  return docs.map((d) => ({ params: { slug: d.slug } }));
}

const d = docs.find((x) => x.slug === Astro.params.slug);
const i = docs.indexOf(d);
const prev = docs[i - 1];
const next = docs[i + 1];
---
<Base title={`${d.title} · ${d.variant}`} description={d.desc} lang={d.lang}>
  <div class="viewer" data-viewer data-src={d.pdfUrl} data-file={d.file}>
    <div class="vbar">
      <div class="vbar-inner">
        <a class="icon-btn" href={url('/docs/')} aria-label="Բոլոր փաստաթղթերը" title="Բոլոր փաստաթղթերը"><Icon name="arrow-left" /></a>
        <div class="vtitle">
          <b>{d.title}</b>
          <span class="tnum">{d.variant} · {d.pages} էջ · {d.size}</span>
        </div>
        <div class="vctrl">
          <label class="vpage">
            <span class="sr-only">Էջ</span>
            <input type="number" inputmode="numeric" min="1" max={d.pages} value="1" data-page-input />
            <span class="tnum">/ {d.pages}</span>
          </label>
          <div class="vzoom" role="group" aria-label="Մասշտաբ">
            <button type="button" data-zoom="-1" aria-label="Փոքրացնել" title="Փոքրացնել"><Icon name="zoom-out" /></button>
            <button type="button" class="zval tnum" data-zoom-fit title="Ըստ լայնության">100%</button>
            <button type="button" data-zoom="1" aria-label="Մեծացնել" title="Մեծացնել"><Icon name="zoom-in" /></button>
          </div>
          <a class="icon-btn" href={d.pdfUrl} download={d.file} aria-label="Ներբեռնել PDF" title="Ներբեռնել PDF"><Icon name="download" /></a>
          <a class="icon-btn" href={d.pdfUrl} target="_blank" rel="noopener" aria-label="Բացել նոր ներդիրում" title="Բացել նոր ներդիրում"><Icon name="external" /></a>
          <a class="btn btn-ghost btn-sm vweb" href={d.webHref}>Վեբ տարբերակ</a>
        </div>
      </div>
    </div>

    <div class="vbody">
      <aside class="vthumbs" data-thumbs aria-label="Էջեր"></aside>
      <div class="vpages" data-pages-el>
        <div class="vstatus" data-status>
          <span class="spinner" aria-hidden="true"></span>
          <span data-status-text>Բեռնվում է…</span>
        </div>
      </div>
    </div>
  </div>

  <div class="container vfoot">
    {prev ? <a class="vnav" href={prev.href}><small>← Նախորդ փաստաթուղթը</small><b>{prev.title}</b><span>{prev.variant}</span></a> : <span></span>}
    {next ? <a class="vnav next" href={next.href}><small>Հաջորդ փաստաթուղթը →</small><b>{next.title}</b><span>{next.variant}</span></a> : <span></span>}
  </div>
  <noscript><p class="container">PDF-ը դիտելու համար անհրաժեշտ է JavaScript։ <a href={d.pdfUrl}>Ներբեռնել PDF</a></p></noscript>
</Base>

<script>
  import '../../scripts/pdf-viewer.js';
</script>

<style>
  .viewer { background: var(--viewer-bg); border-bottom: 1px solid var(--line); }
  .vbar {
    position: sticky; top: var(--header-h); z-index: 40; background: var(--surface);
    border-bottom: 1px solid var(--line); box-shadow: var(--shadow-sm);
  }
  .vbar-inner { display: flex; align-items: center; gap: 14px; height: 60px; padding: 0 20px; max-width: 1600px; margin: 0 auto; }
  .vtitle { display: grid; min-width: 0; line-height: 1.3; }
  .vtitle b { color: var(--ink); font-size: 15px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .vtitle span { color: var(--muted); font-size: 12.5px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .vctrl { margin-left: auto; display: flex; align-items: center; gap: 8px; }
  .vpage { display: flex; align-items: center; gap: 6px; font-size: 14px; color: var(--muted); }
  .vpage input {
    width: 54px; height: 38px; border-radius: 10px; border: 1px solid var(--line); background: var(--surface-2); color: var(--ink);
    text-align: center; font: inherit; font-weight: 650; -moz-appearance: textfield;
  }
  .vpage input::-webkit-inner-spin-button, .vpage input::-webkit-outer-spin-button { -webkit-appearance: none; margin: 0; }
  .vzoom { display: flex; align-items: center; border: 1px solid var(--line); border-radius: 10px; overflow: hidden; height: 38px; }
  .vzoom button { border: 0; background: var(--surface); height: 100%; min-width: 36px; display: grid; place-items: center; cursor: pointer; color: var(--text-2); }
  .vzoom button:hover { background: var(--sunken); color: var(--ink); }
  .vzoom :global(svg) { width: 18px; height: 18px; }
  .zval { font-size: 13px; font-weight: 650; padding: 0 8px; border-left: 1px solid var(--line) !important; border-right: 1px solid var(--line) !important; min-width: 58px !important; }
  @media (max-width: 860px) {
    .vweb, .vctrl > a[target] { display: none; }
    .vbar-inner { padding: 0 12px; gap: 10px; }
  }
  @media (max-width: 560px) {
    .vtitle span { display: none; }
    .vzoom [data-zoom] { display: none; }
    .vpage span:last-child { display: none; }
  }

  .vbody { display: grid; grid-template-columns: 176px minmax(0, 1fr); max-width: 1600px; margin: 0 auto; }
  .vthumbs {
    position: sticky; top: calc(var(--header-h) + 61px); height: calc(100vh - var(--header-h) - 61px);
    overflow-y: auto; padding: 18px 14px 40px 20px; display: flex; flex-direction: column; gap: 14px; scrollbar-width: thin;
  }
  .vpages { min-height: calc(100vh - var(--header-h) - 61px); padding: 28px 16px 64px; display: flex; flex-direction: column; align-items: center; gap: 40px; }
  @media (max-width: 900px) {
    .vbody { grid-template-columns: minmax(0, 1fr); }
    .vthumbs { display: none; }
    .vpages { padding: 16px 8px 48px; gap: 34px; }
  }
  .vstatus { margin: 18vh auto; display: flex; align-items: center; gap: 12px; color: var(--text-2); font-size: 15px; }
  .vstatus :global(a) { color: var(--accent-ink); }
  .spinner { width: 22px; height: 22px; border-radius: 50%; border: 2.5px solid var(--line-strong); border-top-color: var(--accent); animation: spin 0.8s linear infinite; }
  .vstatus.error .spinner { display: none; }
  @keyframes spin { to { transform: rotate(360deg); } }

  .vfoot { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 16px; padding-top: 32px; }
  .vnav { display: grid; gap: 2px; padding: 16px 18px; border-radius: var(--radius); border: 1px solid var(--line); background: var(--surface); text-decoration: none; }
  .vnav:hover { border-color: var(--line-strong); box-shadow: var(--shadow-sm); }
  .vnav small { color: var(--muted); font-size: 12.5px; }
  .vnav b { color: var(--ink); font-size: 16px; }
  .vnav span { color: var(--text-2); font-size: 14px; }
  .vnav.next { text-align: right; }
  @media (max-width: 640px) { .vfoot { grid-template-columns: minmax(0, 1fr); } }
</style>

<style is:global>
  /* Elements created by pdf-viewer.js */
  .vpage-shell {
    position: relative; background: #fff; border-radius: 3px; flex: none; max-width: 100%;
    box-shadow: 0 1px 3px rgb(0 0 0 / 0.12), 0 12px 32px -12px rgb(11 37 69 / 0.35);
  }
  .vpage-shell canvas { display: block; width: 100%; height: 100%; border-radius: 3px; }
  .vpage-num {
    position: absolute; right: -2px; bottom: -26px; font-size: 11.5px; color: var(--muted); font-variant-numeric: tabular-nums;
  }
  .vthumb {
    border: 0; padding: 0; background: none; cursor: pointer; display: grid; gap: 6px; justify-items: center; color: var(--muted);
    font-size: 12px; font-variant-numeric: tabular-nums;
  }
  .vthumb .tcanvas {
    width: 100%; background: #fff; border-radius: 3px; overflow: hidden; outline: 2px solid transparent; outline-offset: 3px;
    box-shadow: 0 1px 3px rgb(0 0 0 / 0.15); transition: outline-color 0.15s;
  }
  .vthumb canvas { display: block; width: 100%; height: auto; }
  .vthumb:hover .tcanvas { outline-color: var(--line-strong); }
  .vthumb[aria-current='true'] { color: var(--ink); font-weight: 700; }
  .vthumb[aria-current='true'] .tcanvas { outline-color: var(--accent); }
</style>
